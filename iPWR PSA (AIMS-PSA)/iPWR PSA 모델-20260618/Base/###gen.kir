RdEqn .
ADS-TOP = GADS-ADSV01 * GADS-ADSV02 * GADS-ADSV03 .
GADS-ADSV01 = ADEVO-01 + GADS-ADSV01-CCF + GADS1-SUP .
GADS-ADSV02 = ADEVO-02 + GADS-ADSV02-CCF + GADS2-SUP .
GADS-ADSV03 = ADEVO-03 + GADS-ADSV03-CCF + GADS3-SUP .
GADS-ADSV01-CCF = GADS-ADSV01-CCF2 + ADEVW-010203 .
GADS-ADSV01-CCF2 = ADEVW-0102 + ADEVW-0103 .
GADS-ADSV02-CCF = GADS-ADSV02-CCF2 + ADEVW-010203 .
GADS-ADSV02-CCF2 = ADEVW-0102 + ADEVW-0203 .
GADS-ADSV03-CCF = GADS-ADSV03-CCF2 + ADEVW-010203 .
GADS-ADSV03-CCF2 = ADEVW-0103 + ADEVW-0203 .
GADS1-SUP = GADS-SIGNAL + EPDCF-480V-DIV1 .
GADS-SIGNAL = ADEFF-AUTO * ADOPV-ADS .
GADS2-SUP = GADS-SIGNAL + EPDCF-480V-DIV2 .
GADS3-SUP = GADS-SIGNAL + GEPDCF-480V-DIV1/2 .
GEPDCF-480V-DIV1/2 = EPDCF-480V-DIV2 * EPDCF-480V-DIV1 .
GCCS-TRA = GCCS-TRA-NOFLOW-1 + GCCS-TRA-NOFLOW-2 .
GCCS-MP01-FTS = CCMPW-MP0102 + CCMPS-01 .
GCCS-MP01-FTR = CCMPK-MP0102 + CCMPR-MP01 .
GCCS-MP01-SUPPORTING = GCCS-SIGNAL + EPEKF-6.9KV-DIV1 .
GCCS-MP01-FAILURE = GCCS-MP01-FTS + GCCS-MP01-FTR + GCCS-MP01-SUPPORTING .
GCCS-SV01-FAIL = CCEVO-01 + CCEVW-0104 + GCCS1-SUP .
GCCS-TRA-NOFLOW-1 = CCTNF-CCSPOOL-TRA + GCCS-SV01-FAIL + GCCS-MP01-FAILURE .
GCCS-TRA-NOFLOW-2 = GCCS-TRA-NOFLOW-CBS2 * GCCS-TRA-NOFLOW-CBS3 .
GCCS-TRA-NOFLOW-CBS2 = CCSPF-CBS2 + GCCS-SV02-FAIL .
GCCS-TRA-NOFLOW-CBS3 = CCSPF-CBS3 + GCCS-SV03-FAIL .
GCCS-SV02-FAIL = CCEVO-02 + CCEVW-0205 + GCCS2-SUP .
GCCS-SV03-FAIL = CCEVO-03 + CCEVW-0306 + GCCS3-SUP .
GCCS-TRB = GCCS-TRB-NOFLOW-1 + GCCS-TRB-NOFLOW-2 .
GCCS-TRB-NOFLOW-1 = CCTNF-CCSPOOL-TRB + GCCS-SV04-FAIL + GCCS-MP02-FAILURE .
GCCS-TRB-NOFLOW-2 = GCCS-TRB-NOFLOW-CBS5 * GCCS-TRB-NOFLOW-CBS6 .
GCCS-SV04-FAIL = CCEVO-04 + CCEVW-0104 + GCCS4-SUP .
GCCS-MP02-FAILURE = GCCS-MP02-FTS + GCCS-MP02-FTR + GCCS-MP02-SUPPORTING .
GCCS-MP02-FTS = CCMPW-MP0102 + CCMPS-02 .
GCCS-MP02-FTR = CCMPK-MP0102 + CCMPR-MP02 .
GCCS-MP02-SUPPORTING = GCCS-SIGNAL + EPEKF-6.9KV-DIV2 .
GCCS-TRB-NOFLOW-CBS5 = CCSPF-CBS5 + GCCS-SV05-FAIL .
GCCS-TRB-NOFLOW-CBS6 = CCSPF-CBS6 + GCCS-SV06-FAIL .
GCCS-SV05-FAIL = CCEVO-05 + CCEVW-0205 + GCCS5-SUP .
GCCS-SV06-FAIL = CCEVO-06 + CCEVW-0306 + GCCS6-SUP .
GCCS-TOP = GCCS-TRA * GCCS-TRB .
GCCS-SIGNAL = CSEFF-AUTO * CSOPV-ADS .
GCCS1-SUP = GCCS-SIGNAL + EPDCF-480V-DIV1 .
GCCS2-SUP = GCCS-SIGNAL + EPDCF-480V-DIV1 .
GCCS3-SUP = GCCS-SIGNAL + EPDCF-480V-DIV1 .
GCCS4-SUP = GCCS-SIGNAL + EPDCF-480V-DIV2 .
GCCS5-SUP = GCCS-SIGNAL + EPDCF-480V-DIV2 .
GCCS6-SUP = GCCS-SIGNAL + EPDCF-480V-DIV2 .
GIS-TOP = GGIS-TRA-FAILURE * GGIS-TRB-FAILURE .
GGIS-TRA-FAILURE = GGIS-SV02-FAIL + GGIS-CV02-FAIL + GITKF-01 .
GGIS-SV02-FAIL = GISVO-02 + GISVW-0204 .
GGIS-TRB-FAILURE = GGIS-SV04-FAIL + GGIS-CV03-FAIL + GITKF-02 .
GGIS-SV04-FAIL = GISVO-04 + GISVW-0204 .
GGIS-CV02-FAIL = GICVO-01 + GICVW-0103 .
GGIS-CV03-FAIL = GICVO-03 + GICVW-0103 .
IPWR-TOP = GIE-LOCA + GIE-LOFW .
GIE-LOCA = GIE-LOCA-02 + GIE-LOCA-04 + GIE-LOCA-05 + GIE-LOCA-07 + GIE-LOCA-09 + GIE-LOCA-10 .
GIE-LOFW = GIE-LOFW-03 + GIE-LOFW-05 + GIE-LOFW-06 + GIE-LOFW-08 + GIE-LOFW-10 + GIE-LOFW-11 + GIE-LOFW-12 .
PDHRS-01 = GPDHR-TRA * GPDHR-TRB .
PDHRS-02 = GPDHR-TRA + GPDHR-TRB .
GPDHR-TRA = GPDHR-VV1 + GPDHR-HX01 + GPDHR-VV2 .
GPDHR-TRB = GPDHR-VV3 + GPDHR-HX02 + GPDHR-VV4 .
GPDHR-VV1 = RHVVO-VV1 + RHSVW-VV1/3 .
GPDHR-HX01 = RHHXP-01A .
GPDHR-VV2 = RHVVO-SV2 + RHVVW-VV2/4 .
GPDHR-VV3 = RHVVO-SV3 + RHSVW-VV1/3 .
GPDHR-HX02 = RHHXP-02B .
GPDHR-VV4 = RHVVO-SV2 + RHVVW-VV2/4 .
GPIS-TRA-FAILURE = GPIS-SV02-FAIL + GPIS-CV02-FAIL + PITKS-01 .
GPIS-SV02-FAIL = PISVO-02 + PISVW-0204 .
GPIS-CV02-FAIL = PICVO-01 + PICVW-0103 .
PIS-TOP = GPIS-TRA-FAILURE * GPIS-TRB-FAILURE .
GPIS-TRB-FAILURE = GPIS-SV04-FAIL + GPIS-CV03-FAIL + PITKS-02 .
GPIS-SV04-FAIL = PISVO-04 + PISVW-0204 .
GPIS-CV03-FAIL = PICVO-03 + PICVW-0103 .
PSV-TOP = PZSVW-TRA/B + PSV-TRA/B .
PSV-TRA/B = PZSVO-TRB * PZSVO-TRA .
RT-TOP = REACTOR-TRIP .
GIE-LOCA-02 = %LOCA-RCS-RSV * GCCS-TOP * #GIE-LOCA-02 * /G&-SIM-N[1] .
GIE-LOCA-04 = %LOCA-RCS-RSV * PDHRS-01 * GCCS-TOP * #GIE-LOCA-04 * /G&-SIM-N[2] .
GIE-LOCA-05 = %LOCA-RCS-RSV * PDHRS-01 * GIS-TOP * #GIE-LOCA-05 * /G&-SIM-N[3] .
GIE-LOCA-07 = %LOCA-RCS-RSV * PIS-TOP * GCCS-TOP * #GIE-LOCA-07 * /G&-SIM-N[4] .
GIE-LOCA-09 = %LOCA-RCS-RSV * PIS-TOP * PDHRS-02 * GCCS-TOP * #GIE-LOCA-09 * /G&-SIM-N[5] .
GIE-LOCA-10 = %LOCA-RCS-RSV * /RT-TOP * PIS-TOP * PDHRS-02 * GIS-TOP * #GIE-LOCA-10 .
GIE-LOFW-03 = %LOFW * PDHRS-01 * GCCS-TOP * #GIE-LOFW-03 * /G&-SIM-N[6] .
GIE-LOFW-05 = %LOFW * PDHRS-01 * PIS-TOP * GCCS-TOP * #GIE-LOFW-05 * /G&-SIM-N[7] .
GIE-LOFW-06 = %LOFW * PDHRS-01 * PIS-TOP * GIS-TOP * #GIE-LOFW-06 * /G&-SIM-N[8] .
GIE-LOFW-08 = %LOFW * PDHRS-01 * ADS-TOP * GCCS-TOP * #GIE-LOFW-08 * /G&-SIM-N[9] .
GIE-LOFW-10 = %LOFW * PDHRS-01 * ADS-TOP * PIS-TOP * GCCS-TOP * #GIE-LOFW-10 * /G&-SIM-N[10] .
GIE-LOFW-11 = %LOFW * PDHRS-01 * ADS-TOP * PIS-TOP * GIS-TOP * #GIE-LOFW-11 * /G&-SIM-N[11] .
GIE-LOFW-12 = %LOFW * /RT-TOP * PDHRS-01 * ADS-TOP * PSV-TOP * #GIE-LOFW-12 .
G&-SIM-N[1] = RT-TOP + PIS-TOP + PDHRS-01 .
G&-SIM-N[2] = RT-TOP + PIS-TOP + GIS-TOP .
G&-SIM-N[3] = RT-TOP + PIS-TOP .
G&-SIM-N[4] = RT-TOP + PDHRS-02 .
G&-SIM-N[5] = RT-TOP + GIS-TOP .
G&-SIM-N[6] = RT-TOP + ADS-TOP + PIS-TOP .
G&-SIM-N[7] = RT-TOP + ADS-TOP + GIS-TOP .
G&-SIM-N[8] = RT-TOP + ADS-TOP .
G&-SIM-N[9] = RT-TOP + PSV-TOP + PIS-TOP .
G&-SIM-N[10] = RT-TOP + PSV-TOP + GIS-TOP .
G&-SIM-N[11] = RT-TOP + PSV-TOP .
End .
 
